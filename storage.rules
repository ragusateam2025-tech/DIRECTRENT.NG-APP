rules_version = '2';

// Directrent.ng — Firebase Storage security rules
//
// Publish these in the Firebase console for project `directrent-prod`:
//   Build → Storage → Rules → paste → Publish
//
// Storage must be enabled on the project first; it is not on by default.
//
// Photos are namespaced by owner: listings/{uid}/{listingId}/{n}.jpg. A
// landlord may write only under their own uid, so one account cannot
// overwrite or delete another's property photographs.

service firebase.storage {
  match /b/{bucket}/o {

    match /listings/{userId}/{allPaths=**} {
      // Any signed-in user may view listing photos — tenants need to see them.
      allow read: if request.auth != null;

      // Only the owning landlord may upload, and only images.
      //
      // The 2 MB ceiling is a backstop against a client that skips
      // compression, not the target: the app resizes to a long edge of 1600px
      // and aims for roughly 300 KB before upload. On Lagos mobile data the
      // difference between 300 KB and a raw 8 MB camera frame decides whether
      // a landlord finishes the form.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Delete is its own rule, and must be.
      //
      // `write` covers create, update and delete together, so the size and
      // content-type checks above were being applied to deletions as well —
      // and on a delete there is no incoming file, so request.resource is null
      // and reading .size on it fails. Every deletion was refused.
      //
      // Nothing ever reported it: deletePhoto and discardDraft both swallow
      // storage errors, by design, so that a failed cleanup cannot block an
      // owner mid-form. The visible symptom was only ever a storage bill.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile pictures, one per account at avatars/{uid}.jpg.
    //
    // Readable by any signed-in user because a conversation shows the other
    // party's picture, and a tenant cannot read the owner's user document.
    // Writable only by the account it belongs to, so nobody can replace
    // someone else's face.
    match /avatars/{userId} {
      allow read: if request.auth != null;

      // Tighter than the listing ceiling: an avatar displays at 96px, so
      // anything approaching a megabyte means compression was skipped.
      allow write: if request.auth != null
                   && request.auth.uid + '.jpg' == userId
                   && request.resource.size < 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid + '.jpg' == userId;
    }
  }
}
