{
  "expo": {
    "name": "Directrent",
    "slug": "directrent",
    "scheme": "directrent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A0A0A",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A0A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ng.directrent.app",
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A0A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-image-picker",
        {
          "photosPermission": "Directrent needs access to your photos so you can add pictures of your property to a listing.",
          "cameraPermission": "Directrent needs camera access so you can photograph your property for a listing."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A0A0A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      ["expo-build-properties", { "android": { "minSdkVersion": 24 } }]
    ]
  }
}
