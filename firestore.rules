rules_version = '2';

// Directrent.ng — Firestore security rules
//
// Publish these in the Firebase console for project `directrent-prod`:
//   Build → Firestore Database → Rules → paste → Publish
//
// Authority follows ownership. A listing belongs to the landlord whose uid is
// in ownerId, and only that landlord may change it. Tenants see active
// listings and nothing else — drafts and pending listings are invisible to
// them at every stage.
//
// These supersede the demo rules, which allowed any signed-in user to write
// any listing. That was acceptable for seeded content and is not acceptable
// once real property owners upload.

service cloud.firestore {
  match /databases/{database}/documents {

    // A Directrent employee, not a customer.
    //
    // Reads the flag off the caller's own user document. `.get('staff', false)`
    // rather than `.staff` because a missing field would throw rather than
    // return false, and a rule that errors is a rule nobody can reason about —
    // it would also fail this way for an auth account whose profile document
    // has not been written yet.
    function isStaff() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('staff', false) == true;
    }

    match /listings/{listingId} {
      // A tenant may read a listing only once it is active. A landlord may
      // always read their own, whatever its status.
      //
      // Staff may read any of them, and must be able to: the tour queue lists
      // properties whose owners asked for a shoot, and an owner ticks that box
      // while the listing is still a draft. Without this the queue query is
      // refused outright — Firestore fails a list the moment one document in
      // the result would fail, so a single unowned draft denies the whole
      // screen.
      //
      // This was missing while staff could already *write* a tour, which is the
      // wrong way round: it let an operator attach a tour to a listing they
      // were never permitted to look at. The tests covered the write and not
      // the read, which is exactly how it survived to the device.
      //
      // isStaff() last so the two cheap checks short-circuit for everyone who
      // is not staff, and the user-document read only happens when they fail.
      allow read: if request.auth != null
                  && (resource.data.status.listing == 'active'
                      || resource.data.ownerId == request.auth.uid
                      || isStaff());

      // A landlord may only create a listing owned by themselves. Without
      // this, anyone could create a listing attributed to someone else.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Only the owner may change a listing, and ownership itself is immutable
      // — a listing cannot be reassigned to another account.
      //
      // The two tour fields are carved out and belong to staff alone. An owner
      // who could write `tourReview` could approve their own shoot or erase a
      // decline and appear to still be waiting, which makes the whole decision
      // theatre. An owner who could write `tour` could point it at any address
      // on the internet, and that URL is loaded in a WebView inside our app.
      //
      // hasAny, not hasOnly: this refuses a write that touches either field
      // whatever else it carries, so the fields cannot be smuggled in alongside
      // a legitimate description change.
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['tour', 'tourReview']);

      // Delete is separate, and has to be.
      //
      // It used to share the clause above, which reads
      // request.resource.data.ownerId — and on a delete there is no incoming
      // document, so request.resource is null and the whole condition throws.
      // Every deletion was refused: an owner could not remove their own
      // property, and the wizard's Discard never removed the draft document it
      // claimed to. Both failed silently, because both callers swallow the
      // error so a failed cleanup cannot block someone mid-form.
      //
      // The same mistake, in the same shape, as the one in storage.rules.
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Directrent staff attach 360 tours to listings they did not create, so
      // the ownership clause above can never cover them.
      //
      // Narrow on both sides. The writer must carry staff: true on their own
      // user document — a flag no screen can set, so it cannot be granted to
      // oneself — and the write may touch nothing but the two tour fields. A
      // staff account therefore cannot change a rent, a description or an
      // owner, which keeps an operator's phone from being a master key to the
      // catalogue.
      //
      // `tourReview` is the approve/decline decision. It is writable only here
      // and never by the owner: an owner who could edit it would be able to
      // approve their own shoot, or erase a decline and appear to be waiting.
      // The owner clause above cannot reach it either, because that one refuses
      // any write where the owner is not the author — which is every write to
      // this field.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['tour', 'tourReview']);

      // A temporary clause allowing updates to listings with no ownerId lived
      // here until 10 August 2026, so the seeded documents could be given their
      // market, state and owner. The backfill ran; every listing now has an
      // owner, so the clause matched nothing and has been removed.

      // Interest in a property: who looked, who saved, who enquired.
      //
      // One document per person, named by their own uid, so somebody can only
      // ever record themselves. That is what makes these numbers worth showing:
      // a counter field would have to be writable by every viewer, and a number
      // anyone can set is a number nobody should believe.
      //
      // The owner reads them because they are the point. The person themselves
      // may read their own row, which costs nothing and keeps the rule honest
      // about who the document belongs to.
      function ownsListing() {
        return request.auth.uid ==
          get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId;
      }

      match /views/{viewerId} {
        allow read: if request.auth != null
                    && (request.auth.uid == viewerId || ownsListing());
        allow create, update: if request.auth != null && request.auth.uid == viewerId;
        // Nobody edits away the record that they looked.
        allow delete: if false;
      }

      match /savedBy/{viewerId} {
        allow read: if request.auth != null
                    && (request.auth.uid == viewerId || ownsListing());
        // Delete is allowed here, and only here: unsaving is a real action and
        // the row exists to mirror it.
        allow create, update, delete: if request.auth != null
                                      && request.auth.uid == viewerId;
      }

      match /enquiries/{viewerId} {
        allow read: if request.auth != null
                    && (request.auth.uid == viewerId || ownsListing());
        allow create, update: if request.auth != null && request.auth.uid == viewerId;
        allow delete: if false;
      }
    }

    // Money. Read-only to the two people it concerns, and writable by nobody.
    //
    // Every field here is decided server-side: the amount is recomputed from
    // the listing by a Cloud Function, and the status only ever becomes 'paid'
    // when Paystack's signed webhook says so. Functions use the Admin SDK,
    // which bypasses these rules entirely, so denying all client writes costs
    // nothing and closes the obvious attack — a tenant marking their own rent
    // paid.
    //
    // The tenant reads their own receipts; the owner reads payments against
    // their property, because being told you have been paid is the point.
    match /payments/{paymentId} {
      allow read: if request.auth != null
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid);

      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A person owns their profile — name, phone, picture, role — and may
      // write all of it. With one exception.
      //
      // `staff` is not a profile field, it is a permission: it unlocks the tour
      // queue, which can attach and remove tours on properties the holder does
      // not own. `allow write` covered every field, so any signed-in user could
      // have granted it to themselves with a direct SDK call. No screen offered
      // it, which is not the same thing as nobody being able to do it.
      //
      // So the field is excluded on both paths — it cannot be smuggled in at
      // signup, and it cannot be added later. Granting it is a deliberate act
      // performed in the Firebase console, which is not subject to these rules
      // and is exactly where a permission of this kind should be handed out.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !('staff' in request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['staff']);

      allow delete: if request.auth != null && request.auth.uid == userId;

      match /saved/{listingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // An application is private to the two people it concerns: the tenant who
    // sent it and the landlord who owns the property. Nobody else can read it,
    // which matters because it carries the tenant's name and email.
    match /applications/{applicationId} {
      allow read: if request.auth != null
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.landlordId == request.auth.uid);

      // A tenant may only create an application in their own name. Without this
      // check anyone could submit applications attributed to someone else.
      allow create: if request.auth != null
                    && request.resource.data.tenantId == request.auth.uid;

      // The tenant may edit their own application (to withdraw or resubmit).
      // The landlord may change only the status — accepting or declining — and
      // cannot alter what the tenant wrote.
      // The tenant owns what they wrote, but not the decision on it. Leaving
      // status out of their reach closes a gap where a tenant could mark their
      // own enquiry accepted — no access gained, but a record both sides rely
      // on turned into a lie. Withdrawing is theirs, and is the one status they
      // may set.
      allow update: if request.auth != null
                    && (
                      (resource.data.tenantId == request.auth.uid
                       && request.resource.data.tenantId == resource.data.tenantId
                       && (request.resource.data.status == resource.data.status
                           || request.resource.data.status == 'withdrawn'))
                      ||
                      (resource.data.landlordId == request.auth.uid
                       && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['status']))
                    );

      // Applications are a record for both sides, so neither party deletes
      // them. A tenant withdraws by setting status instead.
      allow delete: if false;
    }

    // A conversation is private to its two participants.
    //
    // FEATURE_SPEC_PART3.md §8.1 routes message writes through Cloud Functions.
    // This app writes to Firestore from the client throughout — listings,
    // applications and saved all do — so these rules carry the validation the
    // function would have done: the sender must be a participant, and must be
    // themselves.
    match /conversations/{conversationId} {
      function participants() {
        return resource.data.participants;
      }

      // A conversation that does not exist yet is readable, and it has to be.
      //
      // Opening one starts by asking whether it already exists. On a document
      // that is not there, `resource` is null, so reading resource.data.
      // participants throws — and a rule that throws denies. The check that
      // must happen before the first message could therefore never pass, which
      // is why an enquiry had never once completed end to end.
      //
      // This leaks nothing. A missing document returns nothing, and an existing
      // one is still readable only by the two people in it.
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid in participants());

      // Either party may open the thread, and must include themselves in it.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // Participants update the thread summary as messages are sent, and clear
      // their own unread count. Who is in the conversation cannot change.
      //
      // The second branch is the enquiry decision, mirrored onto the thread so
      // the conversation list can show where each one stands without reading an
      // application document per row. Only the owner may set it, matching the
      // applications rule — otherwise the copy could disagree with the record
      // it is a copy of, and the copy is what everyone reads.
      //
      // Without this branch the mirror write was simply denied. It is wrapped
      // in a catch so the decision itself still succeeded, which meant the
      // owner saw the badge change, nothing was saved, and the tenant was never
      // told.
      allow update: if request.auth != null
                    && request.auth.uid in participants()
                    && request.resource.data.participants == resource.data.participants
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unread'])
                      ||
                      (request.auth.uid == resource.data.landlordId
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['applicationStatus']))
                    );

      // A conversation is a record for both sides. Neither party erases it.
      allow delete: if false;

      match /messages/{messageId} {
        function inConversation() {
          return request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participants;
        }

        allow read: if request.auth != null && inConversation();

        // A text message may only be created in the sender's own name.
        //
        // A call record is the exception, and deliberately so: it is
        // attributed to whoever placed the call, but written by whichever side
        // ended it — a declined call is recorded by the person who declined.
        // Requiring senderId to match the writer would make that impossible,
        // so for `call` messages participation in the conversation is the
        // check, and the type itself is pinned so this cannot be used to forge
        // an ordinary message in someone else's name.
        allow create: if request.auth != null
                      && inConversation()
                      && (
                        request.resource.data.senderId == request.auth.uid
                        || (request.resource.data.type == 'call'
                            && request.resource.data.senderId in
                               get(/databases/$(database)/documents/conversations/$(conversationId))
                                 .data.participants)
                      );

        // What was said stands. Neither party edits or removes it afterwards.
        //
        // Exception: a call record is written by whichever side ends the call,
        // which may be the person who did not place it — so a message of type
        // `call` may be created by either participant, not only its sender.
        allow update, delete: if false;
      }
    }

    // A call and its signalling. Private to the two people on it.
    //
    // These documents carry session descriptions and network candidates, which
    // are only meaningful to the pair negotiating — but they also reveal who
    // called whom and when, so they are read-restricted for the same reason
    // the conversation is.
    match /calls/{callId} {
      function onCall() {
        return request.auth != null && request.auth.uid in resource.data.participants;
      }

      // Same shape as the conversation rule, and for the same reason: the
      // callee's phone starts listening on a call document before the caller
      // has written it, and a rule that reads resource.data on a missing
      // document throws rather than returning false.
      allow read: if request.auth != null && (resource == null || onCall());

      // A call may only be placed in the caller's own name, and must name two
      // people — one of them the caller.
      allow create: if request.auth != null
                    && request.resource.data.callerId == request.auth.uid
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // Either side updates it as the call progresses: the caller attaches an
      // offer, the callee an answer, and whoever hangs up sets the outcome.
      // Who is on the call cannot change.
      allow update: if onCall()
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.callerId == resource.data.callerId;

      // A call is a record for both sides, like the messages around it.
      allow delete: if false;

      // ICE candidates. Append-only from either side while the call exists.
      //
      // Spelled out as two blocks rather than one wildcard. A path segment in
      // these rules is either a literal or a whole wildcard — `{side}Candidates`
      // is not valid syntax — and matching `/{any}/{id}` instead would open
      // every future subcollection of a call to the same permission.
      match /callerCandidates/{candidateId} {
        allow read, create: if request.auth != null
                            && request.auth.uid in
                               get(/databases/$(database)/documents/calls/$(callId))
                                 .data.participants;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read, create: if request.auth != null
                            && request.auth.uid in
                               get(/databases/$(database)/documents/calls/$(callId))
                                 .data.participants;
        allow update, delete: if false;
      }
    }
  }
}
